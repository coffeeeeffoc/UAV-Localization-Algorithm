    "initial_attitude_std_deg": 3.0,
    "initial_accel_bias_std_mps2": 0.1,
    "initial_gyro_bias_std_radps": 0.005,
    "soft_nis_threshold": 3.841458820694124,
    "hard_nis_threshold": 10.827566170662733,
    "max_variance_scale": 25.0
