{
  "experiment_name": "smoke-v1",
  "evidence_type": "synthetic_simulation",
  "purpose": "Fast integration check; not a performance study",
  "calibration_seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "evaluation_seeds": [
    200,
    201
  ],
  "scenarios": [
    "los",
    "combined"
  ],
  "methods": [
    "uwb",
    "ins",
    "eskf",
    "gated_eskf",
    "adaptive_eskf",
    "robust_eskf"
  ],
  "simulation": {
    "duration_s": 4.0,
    "imu_rate_hz": 100.0,
    "uwb_rate_hz": 10.0,
    "nlos_intervals_s": [
      [
        1.0,
        1.5
      ],
      [
        3.3,
        3.8
      ]
    ],
    "dropout_interval_s": [
      2.0,
      3.0
    ]
